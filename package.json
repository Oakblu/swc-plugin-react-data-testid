{
  "name": "swc-plugin-react-data-testid",
  "version": "0.4.0",
  "description": "SWC plugin that automatically adds unique data-testid attributes to every React JSX element at build time — stable selectors for Playwright, Cypress and Testing Library, including per-item ids inside .map() loops. Zero config.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oakblu/plugin-react-data-testid-generator.git"
  },
  "homepage": "https://github.com/Oakblu/plugin-react-data-testid-generator#readme",
  "bugs": "https://github.com/Oakblu/plugin-react-data-testid-generator/issues",
  "author": "pablohpsilva <pablohpsilva@proton.me>",
  "main": "plugin.wasm",
  "files": [
    "plugin.wasm",
    "scripts/merge-manifest.mjs",
    "CHANGELOG.md",
    "AGENTS.md",
    "llms.txt",
    "schema/plugin-options.schema.json"
  ],
  "bin": {
    "testid-merge-manifest": "scripts/merge-manifest.mjs"
  },
  "keywords": [
    "swc",
    "swc-plugin",
    "react",
    "data-testid",
    "data-test",
    "data-test-id",
    "data-cy",
    "testid",
    "test-id",
    "test-ids",
    "testing",
    "test-automation",
    "e2e",
    "end-to-end-testing",
    "playwright",
    "cypress",
    "testing-library",
    "jest",
    "vitest",
    "selectors",
    "jsx",
    "nextjs",
    "vite",
    "codegen",
    "build-time",
    "wasm",
    "automation",
    "unique-ids"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "cargo build --target wasm32-wasip1 --release && cp target/wasm32-wasip1/release/swc_plugin_react_data_testid.wasm plugin.wasm",
    "test": "cargo test",
    "test:update": "UPDATE=1 cargo test",
    "prepublishOnly": "cargo test && npm run build && node scripts/verify-runtime.cjs",
    "release": "scripts/release.sh",
    "release:minor": "scripts/release.sh minor",
    "release:major": "scripts/release.sh major"
  }
}
